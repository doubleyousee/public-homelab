hostnamectl --static && timedatectl | grep "Time zone:" && uptime -p && df -h / /var /opt 2>/dev/null | awk 'NR==1 || !seen[$1]++' && if [ -f /var/run/reboot-required ]; then echo "REBOOT REQUIRED:"; cat /var/run/reboot-required.pkgs 2>/dev/null; else echo "No reboot required."; fi && if [ -f /run/systemd/shutdown/scheduled ]; then echo "SCHEDULED SHUTDOWN: $(date -d @$(awk -F= '/^USEC=/{print int($2/1000000)}' /run/systemd/shutdown/scheduled))"; fi